#!/usr/bin/env bash
set -euo pipefail

# Install and configure dot-files: place them in $HOME and bootstrap tmux.
#
# Maintainer: asccigcc
#
# Usage:
#   ./install [--yes]

# Run from the repo root so ./sync resolves from any CWD.
cd "$(dirname "$0")"

echo -e "\xE2\x9A\x99 Installing Dot-files \xE2\x9A\x99"

# Copy the dotfiles into $HOME (backs up anything it overwrites).
./sync pull "$@"

echo "Prepare Tmux"
if command -v tmux >/dev/null 2>&1; then
    if [[ ! -d "${HOME}/.tmux/plugins/tpm" ]]; then
        git clone https://github.com/tmux-plugins/tpm "${HOME}/.tmux/plugins/tpm"
    fi
    # Plugin install needs a running server; don't let it abort the install.
    tmux start-server \; source-file "${HOME}/.tmux.conf" 2>/dev/null || true
    "${HOME}/.tmux/plugins/tpm/bin/install_plugins" || true
else
    echo "tmux not found; skipping plugin setup"
fi

echo -e "Installation complete \xE2\x9A\xA1"
