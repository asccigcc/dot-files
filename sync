#!/usr/bin/env bash
set -euo pipefail

# Sync dot-files from $HOME into this git repo
#
# Maintainer: asccigcc
#
# Usage:
#   ./sync

# Run from the repo root so `source config.txt` works from any CWD.
cd "$(dirname "$0")"

echo -e "\xE2\x9A\x99 Sync Dot-files \xE2\x9A\x99"
echo "The following process will overwrite the files tracked in this repo."
read -rp "Do you want to proceed with the dot-files sync? [y/N] " confirm
[[ $confirm =~ ^[Yy]$ ]] || { echo "Synchronization cancelled"; exit 1; }

# Load config variables (files, directories)
source config.txt

# Copy tracked files from $HOME into the repo
for file in "${files[@]}"; do
    echo -e "\U0001F504 Syncing file: ${file}"
    cp "${HOME}/${file}" "$file"
done

# Copy tracked directories. The trailing `/.` copies dotfiles too, which a
# bare `/*` glob would silently skip.
for dir in "${directories[@]}"; do
    echo -e "\U0001F504 Syncing directory: ${dir}"
    cp -Rf "${HOME}/${dir}/." "${dir}/"
done

# Clean secrets. `sed -i.bak … && rm` is portable across GNU and BSD sed;
# plain `sed -i` behaves differently on macOS and would leave secrets in place.
source secrets

for key in "${!my_secret[@]}"; do
    file="${my_secret[$key]}"
    echo -e "\U0001F9F9 Cleaning secret: ${key} in ${file}"
    sed -i.bak "s/${key}=.*/${key}=/" "$file"
    rm -f "${file}.bak"
done

echo -e "Synchronization complete \xE2\x9A\xA1"
