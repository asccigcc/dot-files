#!/bin/bash

# SECRETS
#
# Define here your secrets that you want to blank out from your files when
# running `./sync push`. Each entry is "ENV_VAR:relative_file".
#
# Uses a plain indexed array (not `declare -A`) so it works on the bash 3.2
# that ships with macOS.
#
# Example:
#   secrets=("ENV_VARIABLE:file_name")

# shellcheck disable=SC2034  # consumed by ./sync via `source secrets`
secrets=(
  "BUNDLE_ENTERPRISE__CONTRIBSYS__COM:.zshrc_env"
  "BUNDLE_GITHUB__COM:.zshrc_env"
  "GITHUB_ACCESS_TOKEN:.zshrc_env"
)
